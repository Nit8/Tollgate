# ─────────────────────────────────────────────────────────────
#  Tollgate Server — systemd unit (Linux VPS / bare-metal)
#
#  Install:
#      sudo cp deploy/systemd/tollgate.service /etc/systemd/system/
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now tollgate
#
#  Logs:
#      journalctl -u tollgate -f
# ─────────────────────────────────────────────────────────────

[Unit]
Description=Tollgate License Server
After=network.target

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/opt/tollgate
ExecStart=/usr/bin/dotnet /opt/tollgate/Tollgate.Server.dll
Restart=always
RestartSec=5
KillSignal=SIGINT

# Environment — REPLACE THE SECRETS!
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://0.0.0.0:7431
Environment=Jwt__Secret=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Environment=Admin__Key=REPLACE_WITH_ADMIN_PASSWORD
Environment=Jwt__TokenLifetimeDays=7
# SQLite lives in the writable data dir (ReadWritePaths below).
Environment=Data__Path=/opt/tollgate/data/licenses.db
# REQUIRED in Production — comma-separated origin allow-list.
# Environment=Cors__AllowedOrigins__0=https://app.yourdomain.com

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tollgate/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

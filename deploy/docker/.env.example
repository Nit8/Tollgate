# ─────────────────────────────────────────────────────────────
#  Tollgate Server — .env file for docker-compose
#  Copy this to .env and replace the secrets before running:
#
#      cp .env.example .env
#      nano .env
#      docker compose up -d --build
# ─────────────────────────────────────────────────────────────

# A long random string of >= 32 characters used to sign JWT tokens.
# Generate one with:  openssl rand -base64 48
TOLLGATE_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# The admin password that protects all /api/admin/* endpoints.
# Anyone with this key can mint / revoke licenses for ALL apps.
# Generate one with:  openssl rand -hex 32
TOLLGATE_ADMIN_KEY=change-me-to-a-strong-admin-password

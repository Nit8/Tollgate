###############################################################################
# Tollgate — deterministic checkouts across platforms.
#
# All text is normalized to LF in the repository; Git converts on checkout
# per the contributor's platform settings. Files that MUST stay LF (shell
# scripts) or MUST never be touched (binaries, databases) are explicit.
###############################################################################

# Source code and text — normalized, LF in-repo.
* text=auto
*.cs       text
*.csproj   text
*.props    text
*.targets  text
*.slnx     text
*.json     text
*.md       text
*.yml      text
*.yaml     text
*.editorconfig text
*.gitignore    text
*.gitattributes text
*.http     text
*.ps1      text

# Scripts that break with CRLF — force LF everywhere.
*.sh       text eol=lf

# Windows scripts — CRLF is conventional and safe there.
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Images / packages — never text-normalized.
*.png      binary
*.jpg      binary
*.gif      binary
*.ico      binary
*.nupkg    binary
*.snupkg   binary

# Runtime data — binary, and never diff noise.
*.db       binary
*.dat      binary
*.dll      binary
*.pdb      binary
*.so       binary
*.dylib    binary

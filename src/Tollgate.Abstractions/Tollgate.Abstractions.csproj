<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      netstandard2.0 reaches every .NET runtime of the last decade
      (incl. .NET Framework 4.6.2+ and Unity); net10.0 gets the
      modern API surface. The IsExternalInit shim in Compat/ handles
      records/init on netstandard2.0.
    -->
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>Tollgate.Abstractions</RootNamespace>

    <!-- NuGet packaging metadata (shared values live in Directory.Build.props). -->
    <PackageId>Tollgate.Abstractions</PackageId>
    <Description>
      Drop-in SaaS licensing for any .NET app (WPF, WinForms, ASP.NET, Console).
      Shared abstractions: attributes, enums, DTOs and exceptions used by both
      the Tollgate client library and the Tollgate license server.
    </Description>
    <PackageTags>licensing;saas;subscription;feature;toggle;tollgate;dotnet;nuget</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

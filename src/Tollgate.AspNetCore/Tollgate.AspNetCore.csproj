<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Tollgate.AspNetCore</RootNamespace>

    <!-- NuGet packaging metadata -->
    <PackageId>Tollgate.AspNetCore</PackageId>
    <Version>1.0.0</Version>
    <Authors>Tollgate</Authors>
    <Company>Tollgate</Company>
    <Product>Tollgate</Product>
    <Description>
      ASP.NET Core integration for Tollgate.Licensing — adds a global
      RequireFeatureFilter that automatically enforces [RequireFeature] and
      [RequireTier] attributes on MVC controllers and actions.
    </Description>
    <Summary>ASP.NET Core filter for Tollgate — auto-enforces [RequireFeature].</Summary>
    <PackageTags>aspnet;licensing;tollgate;feature;toggle</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/your-org/tollgate</PackageProjectUrl>
    <RepositoryUrl>https://github.com/your-org/tollgate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <!--
    Bring in ASP.NET Core types (MVC controllers, filters, etc.) via the
    shared framework reference — lighter than installing individual NuGet
    packages and always version-matched to the runtime.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tollgate.Licensing\Tollgate.Licensing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

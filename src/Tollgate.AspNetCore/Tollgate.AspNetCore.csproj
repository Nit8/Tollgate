<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 + net10.0: covers both supported LTS runtimes of ASP.NET Core. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Tollgate.AspNetCore</RootNamespace>

    <!-- NuGet packaging metadata (shared values live in Directory.Build.props). -->
    <PackageId>Tollgate.AspNetCore</PackageId>
    <Description>
      ASP.NET Core integration for Tollgate.Licensing — adds a global
      RequireFeatureFilter that automatically enforces [RequireFeature],
      [RequireTier] and [RequireTrial] attributes on MVC controllers and
      actions.
    </Description>
    <PackageTags>aspnet;licensing;tollgate;feature;toggle</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Bring in ASP.NET Core types (MVC controllers, filters, etc.) via the
    shared framework reference — lighter than installing individual NuGet
    packages and always version-matched to the runtime.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tollgate.Licensing\Tollgate.Licensing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

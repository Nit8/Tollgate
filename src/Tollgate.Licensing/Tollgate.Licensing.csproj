<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0          → cross-platform client (Linux/macOS/Windows via registry)
      net10.0-windows  → WMI fingerprint + DPAPI cache (Windows desktop apps)
      net8.0           → still-supported .NET 8 LTS consumers
    -->
    <TargetFrameworks>net8.0;net10.0;net10.0-windows</TargetFrameworks>
    <RootNamespace>Tollgate.Licensing</RootNamespace>

    <!-- NuGet packaging metadata (shared values live in Directory.Build.props). -->
    <PackageId>Tollgate.Licensing</PackageId>
    <Description>
      Drop-in SaaS licensing for any .NET app (Console, ASP.NET Core, WinForms, WPF).
      Validates licenses against a self-hostable Tollgate server, caches them
      encrypted on disk, and gates features via [RequireFeature] / [RequireTier]
      attributes. Cryptographically verified offline cache with grace period,
      cross-platform machine fingerprinting.
    </Description>
    <PackageTags>licensing;saas;subscription;feature;toggle;tollgate;dotnet;nuget;wpf;winforms;aspnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Client dependencies. Versions come from Directory.Packages.props;
    the net8.0 target uses the 8.x line of the Microsoft.Extensions.*
    packages so it restores cleanly on .NET 8.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <!-- Windows-only packages — pulled in only when targeting net10.0-windows. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tollgate.Abstractions\Tollgate.Abstractions.csproj" />
  </ItemGroup>

  <!-- Test access to the internal encrypted cache (LicenseStore). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Tollgate.Core.Tests" />
  </ItemGroup>

  <!-- Ship README.md inside the NuGet package. -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    MSBuild targets + template — shipped inside the NuGet package.
    When a consumer references the package, the .props file runs on
    their first build and auto-creates tollgate.json in their project
    directory.
  -->
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\" />
  </ItemGroup>

</Project>

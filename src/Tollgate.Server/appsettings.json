{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // JWT signing — used to sign tokens the client caches.
  // Change this in production to a long random string (>= 32 chars).
  // For RSA (recommended in production), set "Jwt:PrivateKey" to a PEM
  // private key and leave "Jwt:Secret" empty — the client then verifies
  // tokens with only the public key.
  "Jwt": {
    "Secret": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG!!",
    "Issuer": "TollgateServer",
    "Audience": "TollgateClient",
    "TokenLifetimeDays": 7
  },

  // Admin password protects all /api/admin/* endpoints (sent as the
  // X-Admin-Key header, never in request bodies).
  // Generate one and KEEP IT SECRET — anyone with this key can
  // mint/revoke licenses for every app on this server.
  "Admin": {
    "Key": "MY-SUPER-SECRET-ADMIN-KEY-CHANGE-ME"
  },

  // Set false to require every AppId to be registered explicitly via
  // /api/admin/apps/register before keys can be generated for it.
  "Apps": {
    "AllowAutoRegister": true
  },

  // Comma-separated CORS origin allow-list. REQUIRED in Production
  // (the server refuses to start with an empty list); permissive in
  // Development. Env var form: Cors__AllowedOrigins__0=https://app.example.com
  "Cors": {
    "AllowedOrigins": ""
  },

  // SQLite file location. Leave empty to auto-detect:
  //   /data/licenses.db when a /data directory exists (Docker volume),
  //   otherwise next to the binary. Env var form: Data__Path=/data/licenses.db
  "Data": {
    "Path": ""
  },

  "Urls": "http://0.0.0.0:7431"
}

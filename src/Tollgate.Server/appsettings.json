{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // JWT signing — used to sign tokens the client caches.
  // Change this in production to a long random string (>= 32 chars).
  // For RSA (recommended in production), set "Jwt:PublicKey" and
  // "Jwt:PrivateKey" PEM blobs and leave "Jwt:Secret" empty.
  "Jwt": {
    "Secret": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG!!",
    "Issuer": "TollgateServer",
    "Audience": "TollgateClient",
    "TokenLifetimeDays": 7
  },

  // Admin password protects all /api/admin/* endpoints.
  // Generate one and KEEP IT SECRET — anyone with this key can
  // mint/revoked licenses for every app on this server.
  "Admin": {
    "Key": "MY-SUPER-SECRET-ADMIN-KEY-CHANGE-ME"
  },

  // Optional: a comma-separated allow-list of valid AppIds.
  // Empty = allow any AppId (key generation will register new ones).
  "Apps": {
    "AllowAutoRegister": true
  },

  "Urls": "http://0.0.0.0:7431"
}

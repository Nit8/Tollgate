{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  // Set real values via environment variables or a deployment secret store:
  //   Jwt__Secret   (>= 32 chars)  — or Jwt__PrivateKey (RSA PEM) for asymmetric signing
  //   Admin__Key    (>= 16 chars)
  // The server FAILS TO START if these are empty or still placeholders.
  "Jwt": {
    "Secret": "",
    "Issuer": "TollgateServer",
    "Audience": "TollgateClient",
    "TokenLifetimeDays": 7
  },
  "Admin": {
    "Key": ""
  },

  // REQUIRED in Production — the server refuses to start on an empty list.
  // Env var form: Cors__AllowedOrigins__0=https://app.example.com
  "Cors": {
    "AllowedOrigins": ""
  },

  "Data": {
    "Path": ""
  },

  "Urls": "http://0.0.0.0:7431"
}
